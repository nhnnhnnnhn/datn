# Remote: postgresql://USER:PASS@db.nhnhn.cloud:2101/datn?sslmode=require
# Local Docker Compose: postgresql://postgres:postgres@db:5432/public
# URL-encode special chars in PASS (! → %21, @ → %40)
DATABASE_URL=postgresql://postgres:postgres@db:5432/public
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: enables VIVID LLM-as-a-Judge grading (otherwise heuristic fallback)
LLM_API_KEY=
# OpenRouter example: google/gemini-3.1-flash-lite  |  openai/gpt-4o-mini
LLM_MODEL=google/gemini-3.1-flash-lite
# OpenAI-compatible host. Leave empty to auto-detect (OpenRouter for sk-or-… / provider/model).
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
# Optional: let quiz generation call the LLM for meaning/reverse/fill_blank
QUIZ_USE_LLM=false
