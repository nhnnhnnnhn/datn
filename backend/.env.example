# Remote: postgresql://USER:PASS@db.nhnhn.cloud:2101/datn?sslmode=require
# Local Docker Compose: postgresql://postgres:postgres@db:5432/public
# URL-encode special chars in PASS (! → %21, @ → %40)
DATABASE_URL=postgresql://postgres:postgres@db:5432/public
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional: enables VIVID LLM-as-a-Judge grading (otherwise heuristic fallback)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
