# Copy to <DEPLOY_PATH>/.env on the server (not in the repo). Generate secrets with: openssl rand -hex 32
# Hex only: the password is embedded in DATABASE_URL
POSTGRES_PASSWORD=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_API_KEY=
LLM_MODEL=
LOG_LEVEL=INFO
# Local port the frontend binds on 127.0.0.1; Tailscale Funnel proxies to it
WEB_PORT=8080
