# Copy to <DEPLOY_PATH>/.env on the server (not in the repo). Generate secrets with: openssl rand -hex 32
# Hex only: the password is embedded in DATABASE_URL
POSTGRES_PASSWORD=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_API_KEY=
LLM_MODEL=
LOG_LEVEL=INFO
# Local port the frontend binds on 127.0.0.1; Tailscale Funnel proxies to it
WEB_PORT=8080
# Docker network of Nginx Proxy Manager (default nginx_default); the frontend joins it as
# vivid-learn-frontend
PROXY_NETWORK=nginx_default
# Host port Postgres listens on, all interfaces (not 5432: another Postgres on the server holds
# it). The router forwards public 2101 and Tailscale Funnel tcp :10000 to it
DB_PORT=15432
